<ProgressScreen>:
    name: "progress"

    MDBoxLayout:
        orientation: "vertical"
        padding: "16dp"
        spacing: "16dp"

        MDLabel:
            text: "Progress"
            font_style: "H5"
            size_hint_y: None
            height: "48dp"

        # Streak info
        MDCard:
            size_hint_y: None
            height: "100dp"
            radius: "12dp"
            padding: "16dp"
            md_bg_color: 0.25, 0.45, 0.85, 1

            MDBoxLayout:
                orientation: "horizontal"

                MDBoxLayout:
                    orientation: "vertical"
                    Label:
                        text: str(root.current_streak)
                        font_size: "48sp"
                        bold: True
                        halign: "center"
                    Label:
                        text: "day streak"
                        font_size: "14sp"
                        color: 0.8, 0.8, 0.8, 1

                Widget:
                    size_hint_x: 0.3

                MDBoxLayout:
                    orientation: "vertical"
                    Label:
                        text: str(root.longest_streak)
                        font_size: "36sp"
                        bold: True
                        halign: "center"
                    Label:
                        text: "best streak"
                        font_size: "14sp"
                        color: 0.8, 0.8, 0.8, 1

        # Stats cards
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "100dp"
            spacing: "12dp"

            MDCard:
                radius: "12dp"
                padding: "12dp"
                md_bg_color: 0.3, 0.7, 0.3, 1

                MDBoxLayout:
                    orientation: "vertical"
                    Label:
                        text: str(root.total_reviewed)
                        font_size: "32sp"
                        bold: True
                        halign: "center"
                    Label:
                        text: "total reviews"
                        font_size: "12sp"
                        color: 0.8, 0.8, 0.8, 1
                        halign: "center"

            MDCard:
                radius: "12dp"
                padding: "12dp"
                md_bg_color: 0.9, 0.6, 0.1, 1

                MDBoxLayout:
                    orientation: "vertical"
                    Label:
                        text: f"{root.accuracy}%"
                        font_size: "32sp"
                        bold: True
                        halign: "center"
                    Label:
                        text: "accuracy"
                        font_size: "12sp"
                        color: 0.8, 0.8, 0.8, 1
                        halign: "center"

        # Weekly chart label
        MDLabel:
            text: "Last 7 Days"
            font_style: "Subtitle1"
            size_hint_y: None
            height: "32dp"

        MDScrollView:
            do_scroll_x: False
            MDList:
                id: weekly_list
                padding: "8dp"

        # Loading
        MDLabel:
            text: "Loading..." if root.is_loading else ""
            halign: "center"
            opacity: 1 if root.is_loading else 0
